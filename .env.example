# Copy to .env only if you need to override the defaults in compose.yaml
PI_UID=1000
PI_GID=1000
# From `getent group video render` on the Pi
VIDEO_GID=44
RENDER_GID=992
WAYLAND_DISPLAY=wayland-0
CEC_PHYS=1.0.0.0
PORT=8765
# 0 = don't open the full-screen home screen on the Pi's display (the desktop stays usable). The remote's Debug drawer also has a switch.
HOME_SCREEN=1
# Kick developer app (kick.com/settings/developer): live status for Kick channels via the official API. Empty = use streamlink.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# To link your Kick account: https://<pi-ip>:8766/auth/kick/callback (register the same URL on the Kick app). Empty = no Kick login.
KICK_REDIRECT=
# Twitch developer app (dev.twitch.tv/console/apps): channel lists and profile pictures
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
