# Copy to .env only if you need to override the defaults in compose.yaml
PI_UID=1000
PI_GID=1000
# From `getent group video render` on the Pi
VIDEO_GID=44
RENDER_GID=992
WAYLAND_DISPLAY=wayland-0
CEC_PHYS=1.0.0.0
PORT=8765
# Roku TV addresses for TV controls (power/volume/input). Set in .env on the Pi, not in the repo.
ROKU_LIVING=
ROKU_BEDROOM=
# HDMI input each TV should switch to when you play (HDMI1..HDMI4). Empty = do not switch.
INPUT_LIVING=
INPUT_BEDROOM=
# 0 = don't open the full-screen home screen on the Pi's display (the desktop stays usable). The remote's Debug drawer also has a switch.
HOME_SCREEN=1
# Remote password (any username). Empty = no password.
PASSWORD=
